#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 grommunio GmbH
#
# Build & deploy the grommunio documentation (Astro + Starlight).
#
# Pipeline:
#   1. install dependencies
#   2. refresh auto-generated content (Gromox man pages, admin CLI, OpenAPI spec)
#   3. build the static site (Astro build + Pagefind search index)
#   4. optional PDF / EPUB exports          (MAKE_PDF=1 / MAKE_EPUB=1)
#   5. optional publish + nginx reload       (PUBLISH=1)
#
# Examples:
#   ./deploy                       # build only, output in dist/
#   MAKE_PDF=1 MAKE_EPUB=1 ./deploy
#   TRANSLATE=1 ./deploy           # also DeepL-translate locales (needs DEEPL_API_KEY)
#   MAKE_PDF=1 PUBLISH=1 ./deploy  # full build + publish to the web root
set -euo pipefail

cd "$(dirname "$0")"

DOCU_ROOT="${DOCU_ROOT:-/srv/www/vhosts/docs.grommunio.com/htdocs}"

# The build version is derived from the checked-out commit by src/version.mjs —
# see that file. Exporting DOC_VERSION here overrides it for one-off builds:
#   DOC_VERSION=2026.08.04 ./deploy
export DOC_VERSION="${DOC_VERSION:-}"
[ -n "${DOC_VERSION}" ] || unset DOC_VERSION

echo "==> Installing dependencies"
if [ -f package-lock.json ]; then npm ci; else npm install; fi

echo "==> Checking for a headless Chromium (diagrams, PDF, EPUB)"
# npm ci does not download Playwright's browser. browser.mjs uses it if present,
# else a system Chromium/Chrome ($CHROMIUM_PATH or $PATH), else downloads
# Playwright's build — never with --with-deps, which requires apt-get.
if ! node scripts/lib/browser.mjs --ensure; then
  if [ -n "${MAKE_PDF:-}${MAKE_EPUB:-}" ]; then
    echo "!! PDF/EPUB export needs Chromium: install the chromium package or set CHROMIUM_PATH." >&2
    exit 1
  fi
  echo "   no browser — diagrams keep their committed SVGs"
fi

echo "==> Refreshing auto-generated content (man pages, admin CLI, OpenAPI)"
npm run gen:all

if [ -n "${TRANSLATE:-}" ]; then
  echo "==> Auto-translating non-English locales (DeepL)"
  npm run translate
fi

echo "==> Building static site (version $(node src/version.mjs))"
npm run build

if [ -n "${MAKE_PDF:-}" ]; then
  echo "==> Generating per-book PDFs"
  npm run pdf
fi
if [ -n "${MAKE_EPUB:-}" ]; then
  echo "==> Generating per-book EPUBs"
  npm run epub
fi

# After the exports: the book pages link the PDF/EPUB files they produce.
echo "==> Checking internal links"
npm run check:links

if [ -z "${PUBLISH:-}" ]; then
  echo "==> Build complete -> dist/  (set PUBLISH=1 to publish to ${DOCU_ROOT})"
  exit 0
fi

# Sanity gate. `rsync --delete` mirrors deletions onto the live site, so a build
# that came out short — an upstream outage emptying a generated section, a
# half-finished build — would remove those pages from production. The generators
# now refuse to publish a degraded tree themselves (scripts/lib/outdir.mjs);
# this is the last check before anything is overwritten.
NEW_PAGES=$(find dist -type f -name '*.html' | wc -l)
echo "==> Built ${NEW_PAGES} HTML files"

if [ "${NEW_PAGES}" -lt 100 ]; then
  echo "!! Refusing to publish: only ${NEW_PAGES} HTML files in dist/ — the build looks incomplete." >&2
  exit 1
fi

if [ -d "${DOCU_ROOT}" ]; then
  LIVE_PAGES=$(find "${DOCU_ROOT}" -type f -name '*.html' 2>/dev/null | wc -l)
  if [ "${LIVE_PAGES}" -gt 0 ] && [ "${NEW_PAGES}" -lt $(( LIVE_PAGES * 90 / 100 )) ]; then
    echo "!! Refusing to publish: ${NEW_PAGES} pages built vs ${LIVE_PAGES} currently live (>10% loss)." >&2
    echo "   If the removal is intentional, re-run with FORCE_PUBLISH=1." >&2
    [ -n "${FORCE_PUBLISH:-}" ] || exit 1
    echo "   FORCE_PUBLISH=1 set — continuing anyway." >&2
  fi
fi

echo "==> Publishing to ${DOCU_ROOT}"
mkdir -p "${DOCU_ROOT}"
rsync -a --delete dist/ "${DOCU_ROOT}/"
systemctl reload nginx
echo "==> Deployed."
